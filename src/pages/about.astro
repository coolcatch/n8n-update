---
import Base from '../layouts/Base.astro';
---

<Base title="About — MySite">
  <section class="py-12">
    <h1 class="text-4xl font-bold">About</h1>
    <p class="mt-4 max-w-2xl text-lg text-gray-600">
      This is a starter template built with Astro and Tailwind CSS.
      It replaces the WordPress + Divi workflow with something faster,
      simpler, and fully yours.
    </p>

    <h2 class="mt-10 text-2xl font-semibold">How it works</h2>
    <ol class="mt-4 list-inside list-decimal space-y-2 text-gray-700">
      <li>Edit the <code class="rounded bg-gray-100 px-1">.astro</code> files in <code class="rounded bg-gray-100 px-1">src/pages/</code></li>
      <li>Run <code class="rounded bg-gray-100 px-1">npm run dev</code> to preview locally</li>
      <li>Push to GitHub — your site deploys automatically</li>
    </ol>

    <h2 class="mt-10 text-2xl font-semibold">Want changes?</h2>
    <p class="mt-4 text-gray-600">
      Just tell Claude Code what you want: "Add a pricing section", "Change the colors to green",
      "Add a blog". It handles the code — you stay focused on the content.
    </p>
  </section>
</Base>
