---
import Base from '../layouts/Base.astro';
---

<Base title="Home — Welcome">
  <!-- Hero -->
  <section class="py-16 text-center">
    <h1 class="text-5xl font-bold tracking-tight">
      Hi, I'm <span class="text-blue-600">building things</span>.
    </h1>
    <p class="mx-auto mt-4 max-w-xl text-lg text-gray-600">
      Puzzle books, AI experiments, and learning in public.
      This is my corner of the internet.
    </p>
  </section>

  <!-- What I'm up to -->
  <section class="grid gap-6 py-12 md:grid-cols-2">
    <a href="/puzzles" class="group rounded-xl border border-gray-200 p-6 hover:shadow-md transition-shadow">
      <span class="text-3xl">🧩</span>
      <h3 class="mt-3 text-lg font-semibold group-hover:text-blue-600">Puzzle Book Library</h3>
      <p class="mt-2 text-sm text-gray-600">
        A growing collection of crossword, logic, and word search puzzle books I'm creating.
      </p>
    </a>
    <a href="/lab" class="group rounded-xl border border-gray-200 p-6 hover:shadow-md transition-shadow">
      <span class="text-3xl">🧪</span>
      <h3 class="mt-3 text-lg font-semibold group-hover:text-blue-600">Lab / Try AI</h3>
      <p class="mt-2 text-sm text-gray-600">
        Experiments with n8n, Claude Code, and modern web tools. Learning what's possible.
      </p>
    </a>
    <a href="/blog" class="group rounded-xl border border-gray-200 p-6 hover:shadow-md transition-shadow">
      <span class="text-3xl">✍️</span>
      <h3 class="mt-3 text-lg font-semibold group-hover:text-blue-600">Blog</h3>
      <p class="mt-2 text-sm text-gray-600">
        Writing about what I'm learning — AI, automation, building without code, and more.
      </p>
    </a>
    <a href="/about" class="group rounded-xl border border-gray-200 p-6 hover:shadow-md transition-shadow">
      <span class="text-3xl">👋</span>
      <h3 class="mt-3 text-lg font-semibold group-hover:text-blue-600">About Me</h3>
      <p class="mt-2 text-sm text-gray-600">
        Who I am, what I'm working on, and how to get in touch.
      </p>
    </a>
  </section>
</Base>
