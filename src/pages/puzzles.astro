---
import Base from '../layouts/Base.astro';

const books = [
  {
    title: "Amazing Sudoku: 120 Sudoku puzzles",
    description: "Unplug and unwind with 120 all-new sudoku puzzles. Features 30 easy, 60 medium, and 30 hard puzzles. One puzzle per page with space to work.",
    category: "Sudoku",
    link: "https://www.amazon.com/dp/B0GLZ3Y85P",
  },
  {
    title: "Super Fun SUDOKU Volume 2",
    description: "120 hand-crafted puzzles designed for casual players who want a relaxing brain workout. 30 easy, 60 medium, 30 hard. Includes complete solutions.",
    category: "Sudoku",
    link: "https://www.amazon.com/dp/B0GLZBBB5L",
  },
];
---

<Base title="Our Puzzle Collections — BrainFun Puzzles" description="Browse and buy our puzzle books on Amazon">
  <section class="py-12">
    <h1 class="text-center text-4xl font-bold text-purple-600">Our Puzzle Collections</h1>

    <!-- Book grid -->
    <div class="mt-12 grid gap-8 md:grid-cols-2">
      {books.map((book) => (
        <div class="rounded-2xl bg-white p-8 shadow-md hover:shadow-lg transition-shadow">
          <h3 class="text-xl font-bold text-purple-600">{book.title}</h3>
          <p class="mt-3 text-gray-600">{book.description}</p>
          <a
            href={book.link}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-6 inline-block rounded-lg bg-purple-600 px-6 py-3 font-medium text-white hover:bg-purple-700 transition-colors"
          >
            Buy on Amazon
          </a>
        </div>
      ))}
    </div>

    <div class="mt-16 rounded-lg bg-gray-50 p-6 text-center">
      <p class="text-gray-600">More puzzle books are in the works.</p>
      <a href="/contact" class="mt-2 inline-block text-purple-600 hover:underline">
        Get notified when new books drop &rarr;
      </a>
    </div>
  </section>
</Base>
