---
import Base from '../layouts/Base.astro';
---

<Base title="Contact — MySite">
  <section class="py-12">
    <h1 class="text-4xl font-bold">Contact</h1>
    <p class="mt-4 text-lg text-gray-600">Get in touch.</p>

    <form class="mt-8 max-w-md space-y-4">
      <div>
        <label for="name" class="block text-sm font-medium">Name</label>
        <input
          type="text"
          id="name"
          name="name"
          required
          class="mt-1 w-full rounded-lg border border-gray-300 px-4 py-2 focus:border-blue-500 focus:outline-none"
        />
      </div>
      <div>
        <label for="email" class="block text-sm font-medium">Email</label>
        <input
          type="email"
          id="email"
          name="email"
          required
          class="mt-1 w-full rounded-lg border border-gray-300 px-4 py-2 focus:border-blue-500 focus:outline-none"
        />
      </div>
      <div>
        <label for="message" class="block text-sm font-medium">Message</label>
        <textarea
          id="message"
          name="message"
          rows="4"
          required
          class="mt-1 w-full rounded-lg border border-gray-300 px-4 py-2 focus:border-blue-500 focus:outline-none"
        ></textarea>
      </div>
      <button
        type="submit"
        class="rounded-lg bg-blue-600 px-6 py-3 text-white hover:bg-blue-700"
      >
        Send message
      </button>
    </form>
  </section>
</Base>
